# ─── Zaytan Hub — variáveis de ambiente ─────────────────────────────────────
# Copie para .env.local (fica fora do Git). SEM nenhuma variável, o app roda
# como PROTÓTIPO: banco simulado no navegador, dados fictícios, Supabase real
# não é acessado.

# mock (padrão) | real
VITE_DATA_MODE=mock

# Modo real — projeto "Financeiro" (Settings → API). O RH usa o MESMO projeto
# (tabelas rh_*, supabase/42_rh_modulo.sql) e o mesmo login.
VITE_SUPABASE_URL=https://SEU_PROJETO_FINANCEIRO.supabase.co
VITE_SUPABASE_ANON_KEY=sua_anon_key_do_financeiro

# APK Android (Capacitor): endereço do site publicado. Dentro do app as
# funções /api/* não existem — elas rodam na Vercel —, então as chamadas de
# Usuários e da sincronização do Inter precisam apontar para lá. No site fica
# vazio (mesma origem). Quem preenche isto de verdade é o workflow do APK.
VITE_API_BASE=

# ─── Só para scripts e funções de servidor (NUNCA com prefixo VITE_) ────────
# Funções da Vercel (/api/usuarios, /api/inter, cron) e a cópia do RH.
SUPABASE_URL=https://SEU_PROJETO_FINANCEIRO.supabase.co
SUPABASE_SERVICE_ROLE_KEY=
CRON_SECRET=

# Cópia única dos dados do CRM RH antigo (npm run rh:copiar-dados).
RH_ORIGEM_URL=https://SEU_PROJETO_RH.supabase.co
RH_ORIGEM_SERVICE_ROLE_KEY=
